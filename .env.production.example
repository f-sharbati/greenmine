NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_ORIGIN=https://greenmineapp.ir
GREENMINE_DATA_DIR=/data
GREENMINE_PYTHON_ROOT=/opt/greenmine/python
PYTHON_EXECUTABLE=/opt/venv/bin/python
GREENMINE_ADMIN_EMAIL=fazi.sharbati@gmail.com
SMTP_REQUIRE_SETUP=1
# Supply private mail settings through /opt/greenmine/config/mail.env (0600).
# Fresh admin setup writes /data/mail.json; never expose these values to NEXT_PUBLIC_*.
